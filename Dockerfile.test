FROM rust:1-bookworm

# Install tmux build dependencies and build from HEAD
RUN apt-get update && apt-get install -y \
    libevent-dev ncurses-dev bison pkg-config \
    && rm -rf /var/lib/apt/lists/*

RUN git clone --depth 1 https://github.com/tmux/tmux.git /tmp/tmux \
    && cd /tmp/tmux \
    && sh autogen.sh \
    && ./configure \
    && make -j$(nproc) \
    && make install \
    && rm -rf /tmp/tmux

WORKDIR /app
COPY . .

# Single-threaded to prevent tmux session conflicts.
# Compile + run happens at container start (not cached in image layer)
# to ensure the binary always matches the source.
CMD ["cargo", "test", "--", "--test-threads=1"]
